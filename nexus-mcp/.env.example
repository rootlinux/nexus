NEXUS_API_BASE_URL=https://api.your-nexus-domain.example/api
# Issue this MCP server a read-only scoped credential, not the full admin token.
NEXUS_SERVICE_TOKEN=your-service-token-here

# Optional: comma-separated Docker-internal hostnames allowed to use http:// instead of https://.
# Leave unset unless NEXUS_API_BASE_URL points at a trusted internal hostname (e.g. a Docker
# Compose service name). http:// is otherwise restricted to localhost/127.0.0.1/::1.
# NEXUS_MCP_ALLOWED_HTTP_HOSTS=backend