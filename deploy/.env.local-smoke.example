# LOCAL DOCKER SMOKE TEMPLATE ONLY.
# This example is for the local smoke stack, not for staging or production deployment.
# `localtest.me` resolves to 127.0.0.1, so these hostnames work without editing `/etc/hosts`.
# MUST CHANGE BEFORE USE: generate a unique SECRET_KEY for this smoke environment.
# Smoke/local/staging/production secrets must never be reused.

SECRET_KEY=replace-with-a-strong-64-plus-character-secret
POSTGRES_PASSWORD=replace-with-a-unique-local-postgres-password
REDIS_PASSWORD=replace-with-a-unique-local-redis-password
APP_ENV=development
ENABLE_BOOTSTRAP_ADMIN=false
ALLOWED_HOSTS=api.nexus.localtest.me
CORS_ALLOWED_ORIGINS=http://app.nexus.localtest.me
NEXT_PUBLIC_API_BASE_URL=http://api.nexus.localtest.me
API_PUBLIC_BASE_URL=http://api.nexus.localtest.me
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
# Public hostnames Caddy serves. The local Caddyfile hardcodes localtest.me and ignores
# these, but the base Compose file requires them to be set so a production stack cannot
# start with an unowned default hostname.
APP_HOST=app.nexus.localtest.me
API_HOST=api.nexus.localtest.me
WEBAUTHN_RP_ID=app.nexus.localtest.me
WEBAUTHN_ORIGIN=http://app.nexus.localtest.me
# Database name. Deployments created before the Nexus rename hold their data in a
# database named "xplatform"; POSTGRES_DB never renames an existing one. Either run
# deploy/scripts/rename-legacy-database.sh once, or set POSTGRES_DB=xplatform here.
POSTGRES_DB=nexus

# --- First administrator (local/dev only; both flags are rejected in production) ---
# Step 1: create the identity. ENABLE_BOOTSTRAP_ADMIN=true above plus these four values.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=
#
# Step 2: enroll that identity's first passkey at /auth/admin-enrollment. Privileged
# accounts cannot sign in with a password alone, and the normal passkey-registration
# endpoint needs a session you cannot get yet — this flag opens the one-time enrollment
# path that closes itself as soon as the account owns a credential.
# ADMIN_WEBAUTHN_RECOVERY_IDENTIFIER must exactly match BOOTSTRAP_ADMIN_USERNAME.
# ENABLE_ADMIN_WEBAUTHN_RECOVERY=false
# ADMIN_WEBAUTHN_RECOVERY_IDENTIFIER=
#
# Step 3: set both flags back to false and restart.

# Optional: independent least-privilege credentials for /api/admin/service/* (used by
# nexus-mcp and similar integrations). Issue nexus-mcp a SERVICE_TOKEN_READ value only.
# Leave a scope unset to deny it outright — there is no combined all-scopes token.
# SERVICE_TOKEN_READ=
# SERVICE_TOKEN_NOTIFY=
# SERVICE_TOKEN_DELETE=

# Email
# Keep capture for local smoke. If you switch to `MAIL_PROVIDER=resend`, you must also set
# a real `RESEND_API_KEY`, a real `MAIL_FROM_EMAIL`, and an https `WEB_BASE_URL`
# that is not localhost or `*.localtest.me`.
MAIL_PROVIDER=capture
MAIL_CAPTURE_DIR=tmp/mail
RESEND_API_KEY=
MAIL_FROM_EMAIL=no-reply@localhost
MAIL_FROM_NAME=Nexus
WEB_BASE_URL=http://app.nexus.localtest.me
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@nexus.localtest.me
