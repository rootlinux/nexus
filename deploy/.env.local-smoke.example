# LOCAL DOCKER SMOKE TEMPLATE ONLY.
# This example is for the production-like local smoke stack, not for staging or production deployment.
# `localtest.me` resolves to 127.0.0.1, so these hostnames work without editing `/etc/hosts`.
# MUST CHANGE BEFORE USE: generate a unique SECRET_KEY for this smoke environment.
# Smoke/local/staging/production secrets must never be reused.

SECRET_KEY=replace-with-a-strong-64-plus-character-secret
APP_ENV=production
ENABLE_BOOTSTRAP_ADMIN=false
ALLOWED_HOSTS=api.nexus.localtest.me
CORS_ALLOWED_ORIGINS=http://app.nexus.localtest.me:3000
NEXT_PUBLIC_API_BASE_URL=http://api.nexus.localtest.me:8000
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
# Local/dev only. This bootstrap path is rejected in production.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=

# Optional: scoped credentials for /api/admin/service/* (used by nexus-mcp and similar
# integrations). Issue nexus-mcp a SERVICE_TOKEN_READ value only — never the notify/delete
# tokens or the deprecated ADMIN_SERVICE_TOKEN, which grants all three scopes.
# SERVICE_TOKEN_READ=
# SERVICE_TOKEN_NOTIFY=
# SERVICE_TOKEN_DELETE=

# Deprecated legacy fallback for /api/admin/service/* — inert unless both are set. Only
# enable while migrating existing deployments to the scoped SERVICE_TOKEN_* vars above.
# ADMIN_SERVICE_TOKEN=
# ENABLE_LEGACY_ADMIN_SERVICE_TOKEN=false

# Email
# Keep capture for local smoke. If you switch to `MAIL_PROVIDER=resend`, you must also set
# a real `RESEND_API_KEY`, a real `MAIL_FROM_EMAIL`, and an https `WEB_BASE_URL`
# that is not localhost or `*.localtest.me`.
MAIL_PROVIDER=capture
MAIL_CAPTURE_DIR=tmp/mail
RESEND_API_KEY=
MAIL_FROM_EMAIL=no-reply@localhost
MAIL_FROM_NAME=Nexus
WEB_BASE_URL=http://localhost:3000
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@nexus.localtest.me
