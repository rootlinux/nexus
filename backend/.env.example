# LOCAL BACKEND DEVELOPMENT ONLY.
# Do not use this file for Docker smoke, staging, or production deployments.
# MUST CHANGE BEFORE USE: `SECRET_KEY` below is a placeholder and must stay unique to this local environment.
# Production/staging/smoke/local must never share the same `SECRET_KEY`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-a-local-dev-secret-before-running
APP_ENV=development
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENABLE_BOOTSTRAP_ADMIN=false
# Local/dev only. Requires all three runtime values and is rejected in production.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=
# Opens the one-time first-passkey enrolment page at /auth/admin-enrollment. A privileged
# account cannot sign in with a password alone and cannot reach ordinary passkey
# registration without a session, so this is the only supported way to enrol the first
# admin credential. Rejected outright in production; closes itself once a key exists.
# ENABLE_ADMIN_WEBAUTHN_RECOVERY=false
# ADMIN_WEBAUTHN_RECOVERY_IDENTIFIER=
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=
REFRESH_COOKIE_DOMAIN=
# Development example only. For the production-like Docker smoke path, use deploy/.env.local-smoke.example.
# Do not copy localhost hosts or secrets from this file into staging or production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
UPLOADS_CACHE_CONTROL=public, max-age=3600

# Email
# Use capture for local development unless you explicitly configure a real provider.
MAIL_PROVIDER=capture
MAIL_CAPTURE_DIR=tmp/mail

# Real provider settings (example placeholders)
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM_EMAIL=no-reply@yourdomain.com
MAIL_FROM_NAME=Nexus
WEB_BASE_URL=https://yourdomain.com
# Where in-app problem reports are delivered. Required (and must not be an example.com
# address) whenever a real mail provider is configured in production.
FEEDBACK_REPORT_TO_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@yourdomain.com

# Media, uploads, and signing (Round 2 hardening)
# API_PUBLIC_BASE_URL is required in production: must be a real HTTPS host with no
# path/query. It is what all media/attachment URLs are built from — never the
# incoming request's Host header. localhost is fine for local dev.
API_PUBLIC_BASE_URL=http://localhost:8000

# Optional and time-bounded: only set this if you must keep honoring signed
# artifacts (e.g. outstanding feedback-attachment links) issued before the
# signing-key purpose separation took effect. Use a real future UTC timestamp
# (e.g. 2026-09-01T00:00:00Z) — never open-ended. Leave unset otherwise.
# SIGNING_KEY_LEGACY_VERIFY_UNTIL=

# Upload size limits (bytes). Defaults shown; uncomment to override.
# AVATAR_UPLOAD_MAX_BYTES=5242880
# COVER_UPLOAD_MAX_BYTES=8388608
# POST_IMAGE_UPLOAD_MAX_BYTES=5242880
# UPLOAD_GUARD_OVERHEAD_BYTES=262144
# PNG_DECOMPRESS_SLACK_BYTES=4096
# PNG_MAX_COMPRESSED_INPUT_BYTES=8388608

# Image re-encoding. Defaults shown; uncomment to override.
# IMAGE_PRESERVE_ICC_PROFILE=false
# IMAGE_REENCODE_JPEG_QUALITY=91
# IMAGE_REENCODE_WEBP_QUALITY=90

# Per-user media quotas. Defaults shown; uncomment to override.
# MEDIA_MAX_FILES_PER_USER=500
# MEDIA_MAX_TOTAL_BYTES_PER_USER=262144000
# MEDIA_MAX_DAILY_UPLOAD_BYTES_PER_USER=52428800
# MEDIA_PENDING_EXPIRATION_HOURS=24
